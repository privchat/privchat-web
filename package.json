{
  "name": "privchat-web",
  "version": "0.0.0",
  "description": "Official PrivChat React Web App. First consumer of @privchat/react.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:virtual": "VITE_PRIVCHAT_VIRTUAL_TIMELINE=1 playwright test",
    "postbuild": "node scripts/gen-version.mjs"
  },
  "dependencies": {
    "@privchat/react": "file:../privchat-react",
    "@privchat/sdk": "file:../privchat-sdk-typescript",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.6",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "@msgtrans/client": "file:../msgtrans-typescript"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "license": "Apache-2.0"
}
